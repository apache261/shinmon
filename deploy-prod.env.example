# Copy to deploy-prod.env and replace every credential before use. This TLS
# transport profile does not by itself constitute production approval.

# PostgreSQL: container identity, service target, and private host publication.
POSTGRES_DB=shinmon
POSTGRES_USER=shinmon
POSTGRES_PASSWORD=replace-with-production-database-password
POSTGRES_HOST=postgres
POSTGRES_SERVICE_PORT=5432
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=4043

# Redis: service target and private host publication.
REDIS_HOST=redis
REDIS_SERVICE_PORT=6379
REDIS_BIND_ADDR=127.0.0.1
REDIS_PORT=4044

# Management and production listener publications.
SHINMON_IMAGE_TAG=v1.0.0
GATEWAY_ADMIN_PORT=4041
GATEWAY_ADMIN_BIND_ADDR=127.0.0.1
GATEWAY_PORT_MIN=4300
GATEWAY_PORT_MAX=4399
HAPROXY_CONFIG_PATH=./deploy/haproxy/haproxy.https.production.cfg
GATEWAY_TLS_DIR=./deploy/tls

# Docker networks and fixed addresses. Change the complete group together if
# either subnet overlaps an existing Docker or host network.
SHINMON_EDGE_SUBNET=10.254.240.0/24
SHINMON_CONTROL_SUBNET=10.254.241.0/24
HAPROXY_EDGE_IP=10.254.240.10
GATEWAY_1_EDGE_IP=10.254.240.21
GATEWAY_2_EDGE_IP=10.254.240.22
GATEWAY_TRUSTED_PROXY_CIDRS=10.254.240.10/32

# Gateway runtime and credentials. Replace all three secret placeholders.
GATEWAY_ENVIRONMENT=production
GATEWAY_LOG_LEVEL=info
GATEWAY_METRICS_BEARER_TOKEN=replace-with-production-metrics-token-32chars
GATEWAY_SHUTDOWN_TIMEOUT=30s
GATEWAY_ADMIN_BEARER_TOKEN=replace-with-production-admin-token-32chars
GATEWAY_API_KEY_PEPPER=replace-with-production-api-key-pepper-32chars
GATEWAY_ADMIN_TLS_CERT_FILE=/etc/shinmon/tls/internal.crt
GATEWAY_ADMIN_TLS_KEY_FILE=/etc/shinmon/tls/internal.key
GATEWAY_ADMIN_HEALTH_SCHEME=https

# PostgreSQL connection pool.
GATEWAY_DATABASE_MIN_CONNECTIONS=2
GATEWAY_DATABASE_MAX_CONNECTIONS=20
GATEWAY_DATABASE_CONNECT_TIMEOUT=10s

# Data-plane refresh, health checks, and upstream policy.
GATEWAY_CONFIG_POLL_INTERVAL=2s
GATEWAY_UPSTREAM_HEALTH_INTERVAL=10s
GATEWAY_UPSTREAM_HEALTH_TIMEOUT=2s
GATEWAY_UPSTREAM_ALLOWED_CIDRS=10.0.0.0/8
# Optional private CA bundle for HTTPS upstream IP certificates.
# GATEWAY_UPSTREAM_TLS_CA_FILE=/etc/shinmon/tls/upstream-ca.pem

# Require two distinct configuration approvers.
GATEWAY_CONFIGURATION_APPROVALS_REQUIRED=2

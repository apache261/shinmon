# Copy to dashboard.env for local development.

# Dashboard listener.
DASHBOARD_PORT=4042
# HTTP profile:
DASHBOARD_LISTEN=4042
# For HTTPS, set DASHBOARD_LISTEN=4042 ssl and set the following to one line:
# ssl_certificate /etc/shinmon/tls/dashboard.crt; ssl_certificate_key /etc/shinmon/tls/dashboard.key; ssl_protocols TLSv1.2 TLSv1.3;
DASHBOARD_TLS_CONFIG=
DASHBOARD_TLS_DIR=./deploy/tls
DASHBOARD_HEALTH_SCHEME=http

# Management API upstream.
# The target must include http:// or https:// and should not include a path or trailing slash.
# Used by the standalone dashboard Compose file. Both deployment scripts override the
# target to gateway-admin on the private control network below.
DASHBOARD_API_TARGET=http://host.docker.internal:4041
# Used by deploy-dev.sh when the dashboard joins the gateway control network.
DASHBOARD_STACK_API_TARGET=http://gateway-admin:4041

# Deployment-script private network integration.
DASHBOARD_CONTROL_NETWORK=shinmon-stack_control

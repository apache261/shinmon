# Non-secret multi-host inventory. Values may not contain spaces.
SHINMON_TRANSPORT_MODE=http
SHINMON_IMAGE_TAG=development
SHINMON_REGISTRY=shinmon
SHINMON_LISTENER_PORT_MIN=4100
SHINMON_LISTENER_PORT_MAX=4199

# DNS mode resolves all gateways through this name. Static mode renders the
# gateway IP addresses below directly into HAProxy.
GATEWAY_DISCOVERY_MODE=dns
GATEWAY_DISCOVERY_NAME=gateway.service.internal
GATEWAY_DISCOVERY_RESOLVER=10.20.0.2
GATEWAY_DISCOVERY_MAX_REPLICAS=8
GATEWAY_TLS_SERVER_NAME=gateway.service.internal
MANAGEMENT_DISCOVERY_NAME=gateway-admin.service.internal

# Format: node-name@private-address, with one role per host.
EDGE_HOSTS=edge-1@10.20.0.10,edge-2@10.20.0.11
GATEWAY_HOSTS=gateway-1@10.20.0.21,gateway-2@10.20.0.22
MANAGEMENT_HOSTS=management-1@10.20.0.31
DASHBOARD_HOSTS=dashboard-1@10.20.0.41

# Used only by optional reachability checks.
SHINMON_SSH_PORT=22
# Required when SHINMON_TRANSPORT_MODE=https. Do not store private keys here.
# SHINMON_TLS_SOURCE_DIR=/secure/path/to/shinmon-tls

# Copy outside source control, replace every credential, and pass the copy to
# render-multihost.sh. PostgreSQL and Redis must be reachable from every node.
GATEWAY_ENVIRONMENT=development
GATEWAY_LOG_LEVEL=info
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_METRICS_BEARER_TOKEN=replace-with-at-least-32-metrics-token-characters
GATEWAY_API_KEY_PEPPER=replace-with-an-independent-32-character-secret
GATEWAY_ADMIN_BEARER_TOKEN=replace-with-at-least-32-admin-token-characters
GATEWAY_CONFIGURATION_APPROVALS_REQUIRED=0
GATEWAY_DATABASE_URL=postgres://shinmon:replace-password@postgres.service.internal:5432/shinmon?sslmode=require
GATEWAY_DATABASE_MIN_CONNECTIONS=1
GATEWAY_DATABASE_MAX_CONNECTIONS=5
GATEWAY_DATABASE_CONNECT_TIMEOUT=10s
GATEWAY_REDIS_URL=rediss://redis.service.internal:6379/0
GATEWAY_UPSTREAM_ALLOWED_CIDRS=10.20.0.0/16
GATEWAY_CONFIG_POLL_INTERVAL=2s
GATEWAY_CONFIG_POLL_JITTER=500ms
GATEWAY_UPSTREAM_HEALTH_INTERVAL=10s
GATEWAY_UPSTREAM_HEALTH_TIMEOUT=2s


# HTTPS dashboard variant for the production listener profile. Supply all
# certificate files from a secrets manager or a private DASHBOARD_TLS_DIR mount.
DASHBOARD_PORT=4042
DASHBOARD_LISTEN=4042 ssl
DASHBOARD_TLS_CONFIG=ssl_certificate /etc/shinmon/tls/dashboard.crt; ssl_certificate_key /etc/shinmon/tls/dashboard.key; ssl_protocols TLSv1.2 TLSv1.3;
DASHBOARD_HEALTH_SCHEME=https
DASHBOARD_TLS_DIR=./deploy/tls

DASHBOARD_API_TARGET=https://gateway-admin:4041
DASHBOARD_STACK_API_TARGET=https://gateway-admin:4041
DASHBOARD_PROXY_TLS_CONFIG=proxy_ssl_verify on; proxy_ssl_trusted_certificate /etc/shinmon/tls/internal-ca.pem; proxy_ssl_server_name on; proxy_ssl_name gateway-admin;
DASHBOARD_CONTROL_NETWORK=shinmon-stack_control
